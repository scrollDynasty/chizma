# Copy to .env and fill in. All values below are FAKE placeholders.
# Never commit a real .env file.

# --- API ---
CHIZMA_ENV=development
CHIZMA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CHIZMA_DATABASE_URL=sqlite:///./data/chizma.db
CHIZMA_PUBLIC_API_URL=http://localhost:8000
CHIZMA_WEB_URL=http://localhost:5173/chizma

# --- Auth (M1) ---
CHIZMA_JWT_SECRET=replace-me-with-a-long-random-string
CHIZMA_GITHUB_CLIENT_ID=fake-github-client-id
CHIZMA_GITHUB_CLIENT_SECRET=fake-github-client-secret
CHIZMA_GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
CHIZMA_GOOGLE_CLIENT_SECRET=fake-google-client-secret
# Comma-separated allow-list for the closed test, e.g. github:yourlogin,google:1234567890. Empty = open.
CHIZMA_ALLOWED_USERS=

# --- AI (M1) ---
# fake | openai
CHIZMA_AI_PROVIDER=fake
CHIZMA_AI_MODEL=gpt-6-luna
OPENAI_API_KEY=sk-REPLACE_ME
CHIZMA_GENERATION_ENABLED=true
CHIZMA_DAILY_USER_LIMIT=30
CHIZMA_DAILY_BUDGET_USD=2

# --- Web (build-time, public values only) ---
VITE_API_URL=http://localhost:8000
